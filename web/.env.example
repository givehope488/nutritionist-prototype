# 前端环境变量（web/.env.local 覆盖，勿提交真实值）
#
# API 基址。切换 Mock 与真实后端只改这里，业务代码禁止写死 URL（COLLAB.md 防线 4）。
# 注意：BASE 只填「源」，前缀 /api/v1 由 client.ts 统一拼接，别再写进 URL。
#   mock://local  -> 使用 web/src/api/__mock__ 内置假后端（后端未就绪时的默认值）
#   http://localhost:8787 -> BE 真实服务（需服务端放行 CORS）
#   （留空）       -> 同源 /api/v1，由 vite.config.ts 的 dev proxy 转到 localhost:8787，免 CORS
VITE_API_BASE=mock://local

# 弱网/异常演练开关（本地调试用）：off | slow | flaky
VITE_MOCK_NETWORK=off

# 手动走查（真后端、同源代理）：不设这个变量会静默走 Mock，容易把「Mock 数据少」误判成产品 bug
# （PD 视觉走查 2026-11-22 记录）。用命令行覆盖即可，不要改本文件：
#   VITE_API_BASE= npm run dev
# 走查前先起后端（根目录 npm run dev @8787），再访问 http://localhost:5173。
