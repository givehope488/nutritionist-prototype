{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@canteen/shared": ["../shared/src/index.ts"],
      "@menu-seed": ["../server/data/menu-seed.json"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "../shared/src/**/*.ts",
    "../server/data/menu-seed.json",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
