{
  "name": "@canteen/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "vitest run src/tests/e2e"
  },
  "dependencies": {
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  }
}
