# syntax=docker/dockerfile:1
#
# 服务端镜像（W3-C1）。
#
# 构建上下文必须是**仓库根**（需要 npm workspaces 的 shared/ 与 server/）：
#   docker build -f deploy/Dockerfile.server -t canteen-server .
#
# 为什么直接用 tsx 跑 TS 而不编译成 JS：仓库本来就是这个运行方式（`npm start` = `tsx src/index.ts`），
# 多一层构建产物只会让「本地能跑、镜像不能跑」多一种可能。代价是镜像里要带 devDependencies。
FROM node:22-slim AS base
WORKDIR /app
ENV NODE_ENV=production

# 先只拷清单文件，利用层缓存：依赖没变时 `npm ci` 这层可以直接复用
COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY server/package.json server/
RUN npm ci --no-audit --no-fund

# 再拷源码（shared 的 TS 源码会被 server 通过 workspace 直接引用）
COPY shared ./shared
COPY server ./server

# 运行期目录：数据库与备份都在 volume 上，镜像里只留空目录
RUN mkdir -p /app/server/data/runtime /app/backups

ENV PORT=8787 \
    DATABASE_URL=/app/server/data/runtime/app.db \
    TEXT_ENGINE=template

EXPOSE 8787

# 健康检查用内置 fetch（Node 22 自带），不额外装 curl
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8787)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# 启动：先按需灌种子（幂等，空库时才有意义），再起服务
CMD ["sh", "-c", "npm run seed -w @canteen/server || true; npm run start -w @canteen/server"]
