# 部署环境变量（W3-C1）
#
# 用法：cp .env.example .env，然后至少把 ADMIN_TOKEN 改成随机串。
# `.env` 已被 .gitignore 忽略，不要提交真实值。

# 管理端 X-Admin-Token。未设置时管理端接口一律 401（compose 里是必填项）。
# 生成：node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=replace-me-with-random-hex

# 文本引擎：template（默认，3 周计划内固定）/ llm（预留）
TEXT_ENGINE=template

# 对外端口：浏览器访问 http://<主机>:8080
WEB_PORT=8080
