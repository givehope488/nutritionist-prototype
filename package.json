{
  "name": "canteen-nutritionist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "食堂营养师 —— 团队版（前后端分离）",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "smoke": "npm run smoke -w @canteen/server",
    "check:data": "node server/scripts/check-data.mjs",
    "check:progress": "node scripts/check-progress.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run smoke && npm run check:data && npm run check:progress",
    "dev": "npm run dev -w @canteen/server",
    "start": "npm run start -w @canteen/server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
