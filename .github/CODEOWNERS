# 目录所有权（GitHub CODEOWNERS）
# 作用：改动越界目录时，GitHub 会自动把对应所有者加成必需 Reviewer，
# 让「只改自己目录」这条规则由平台强制，而不是靠人记。
# 用法：把下面的 @占位符 替换成各成员的 GitHub 用户名。

# 默认兜底：任何未明确归属的文件都要 BE-B 过目
*                                   @be-b

# ---- 共享契约（绝不允许多人随意改）----
/shared/                            @be-b
/docs/API.md                        @be-a
/docs/ARCHITECTURE.md               @be-b
/package.json                       @be-b
/.github/                           @be-b
/.nvmrc                             @be-b

# ---- 前端 ----
/web/src/views/profile/             @fe-a
/web/src/views/goal/                @fe-a
/web/src/views/recommend/           @fe-a
/web/src/api/                       @fe-a @fe-b
/web/src/views/log/                 @fe-b
/web/src/views/feedback/            @fe-b
/web/src/views/history/             @fe-b
/web/src/components/                @fe-b

# ---- 后端 ----
/server/src/engines/                @be-a
/server/src/services/               @be-b
/server/src/llm/                    @be-b
/server/src/admin/                  @be-b
/server/src/routes/                 @be-b

# ---- 数据 ----
/server/data/                       @pd
